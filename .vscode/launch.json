{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: Run Current File",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=${fileBasenameNoExtension}"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated"
        },
        {
            "name": "Rust: Debug Current File",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=${fileBasenameNoExtension}"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated"
        },
        {
            "name": "Rust: Test Current File",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=${fileBasenameNoExtension}"
                ]
            },
            "cwd": "${workspaceFolder}",
            "terminal": "integrated"
        }
    ]
}